# Docker Compose reads these. Copy to .env and fill in; .env is never committed.
DB_NAME=innovation
DB_USER=innovation
DB_PASSWORD=                  # required
DJANGO_SECRET_KEY=            # required: 50+ random characters (python -c "import secrets;print(secrets.token_urlsafe(64))")
DJANGO_ALLOWED_HOSTS=localhost,backend
CORS_ALLOWED_ORIGINS=https://localhost
SECURE_SSL_REDIRECT=0         # TLS ends at your reverse proxy
SECURE_PROXY_SSL=0
TRUST_X_FORWARDED_FOR=0
DJANGO_TIME_ZONE=Asia/Amman
# Every backend variable, with notes, is listed in backend/.env.example.
