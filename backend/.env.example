# Names only. The backend reads these from the process environment (it does not load a .env file by itself).
# Production: DJANGO_SETTINGS_MODULE=config.settings_prod (refuses to start without the required values below).
DJANGO_SETTINGS_MODULE=
DJANGO_SECRET_KEY=            # required in production: 50+ random characters
DJANGO_DEBUG=                 # development only; production forces it off
DJANGO_ALLOWED_HOSTS=         # required in production: comma-separated host names, no "*"
DJANGO_TIME_ZONE=
CORS_ALLOWED_ORIGINS=         # required in production: https:// address of the web app
PRIVATE_MEDIA_ROOT=           # where uploaded files live (back this folder up with the database)
DJANGO_STATIC_ROOT=
DJANGO_CACHE_DIR=
DJANGO_LOG_LEVEL=
SECURE_PROXY_SSL=             # 1 when a reverse proxy ends TLS and sets X-Forwarded-Proto
SECURE_SSL_REDIRECT=          # defaults to 1 in production
SECURE_HSTS_SECONDS=
TRUST_X_FORWARDED_FOR=        # 1 only behind a proxy you control that sets this header

# Postgres (optional; SQLite is used when DB_ENGINE is not "postgres")
DB_ENGINE=
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=

# Only for `python manage.py seed`
CEO_EMAIL=
CEO_PASSWORD=
CEO_NAME=
