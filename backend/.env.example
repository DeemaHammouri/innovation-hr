# Names only. The backend reads these from the process environment (it does not load a .env file by itself).
DJANGO_SECRET_KEY=
DJANGO_DEBUG=
DJANGO_ALLOWED_HOSTS=
DJANGO_TIME_ZONE=
CORS_ALLOWED_ORIGINS=
PRIVATE_MEDIA_ROOT=

# Postgres (optional; SQLite is used when DB_ENGINE is not "postgres")
DB_ENGINE=
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=

# Only for `python manage.py seed`
CEO_EMAIL=
CEO_PASSWORD=
CEO_NAME=
